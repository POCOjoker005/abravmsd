<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_update_income_account_wizard_form" model="ir.ui.view">
        <field name="name">account.move.update.income.account.wizard.form</field>
        <field name="model">account.move.update.income.account.wizard</field>
        <field name="arch" type="xml">
            <form string="Update Income Account">
                <field name="move_id" invisible="1"/>
                <field name="company_id" invisible="1"/>
                <group>
                    <field name="income_account_id" options="{'no_create': True}"/>
                </group>
                <footer>
                    <button name="action_confirm" type="object"
                            string="Confirm" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
