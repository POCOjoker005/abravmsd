<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_move_form_update_income_account" model="ir.ui.view">
        <field name="name">account.move.form.update.income.account.button</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">

            <xpath expr="//header" position="inside">
                <button name="action_open_update_income_account" type="object"
                        string="Update Income Account"
                        class="btn-secondary"
                        invisible="state != 'draft' or move_type not in ('out_invoice', 'out_refund')"/>
            </xpath>

        </field>
    </record>

</odoo>
