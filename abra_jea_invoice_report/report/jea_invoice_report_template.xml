<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="report_jea_invoice_document">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                    <t t-set="doc" t-value="o"/>

                    <div class="jea_invoice">
                        <style>
                            .jea_invoice { font-family: 'Helvetica Neue', Arial, sans-serif; color: #2b2b2b; font-size:
                            12px; }
                            .jea_invoice table { border-collapse: collapse;width: 100%; }
                            .jea_invoice .jea-header-row { margin-bottom: 24px; }
                            .jea_invoice .jea-logo { max-height: 60px; }
                            .jea_invoice .jea-company-address { text-align: right; color: #6b6b6b; font-size: 11px;
                            line-height: 1.5; }
                            .jea_invoice .jea-divider { border: none; border-top: 2px solid #c9a45c; margin: 18px 0;
                            position: relative; }
                            .jea_invoice .jea-info-table td {padding: 6px 10px; }
                            .jea_invoice .jea-info-table td.jea-label { font-weight: bold; width: 90px;
                            background-color: #f4f4f4; }
                            .jea_invoice .jea-billto { border: none; vertical-align: top; padding-right: 20px; }
                            .jea_invoice .jea-refs-table td, .jea_invoice .jea-refs-table th { border: 1px solid
                            #1f3864; padding: 8px 10px; vertical-align: top; }
                            .jea_invoice .jea-refs-table th { background-color: #f4f4f4; text-align: center; font-size:
                            11px; }
                            .jea_invoice .jea-lines-table td, .jea_invoice .jea-lines-table th { border: 1px solid
                            #1f3864; padding: 6px 8px; font-size: 11px; }
                            .jea_invoice .jea-lines-table th { background-color: #f4f4f4; text-align: center; }
                            .jea_invoice .jea-lines-table td.num { text-align: right; }
                            .jea_invoice .jea-lines-table td.center { text-align: center; }
                            .jea_invoice .jea-grand-total td { font-weight: bold; padding:
                            8px 10px; }
                            .jea_invoice .jea-amount-words { margin: 14px 0; font-size: 12px; }
                            .jea_invoice .jea-signature-block { text-align: center; margin-top: 10px; }
                            .jea_invoice .jea-stamp-placeholder { width: 90px; height: 90px; border: 2px dashed #999;
                            border-radius: 50%; display: inline-block; margin-bottom: 6px; }
                            .jea_invoice .jea-payment-info { margin-top: 24px; font-size: 10px; color: #6b6b6b; }
                            .jea_invoice .jea-payment-info strong { color: #2b2b2b; }
                            .jea_invoice .no-border,
                            .jea_invoice .no-border tr,
                            .jea_invoice .no-border td,
                            .jea_invoice .no-border th {
                            border: none !important;
                            }
                        </style>


                        <!-- ============ Bill To  /  Invoice meta table ============ -->
                        <table style="width:100%; border:none !important; border-collapse:collapse;">
                            <tr style="border: none !important;
                                border-style: hidden !important;
                                outline: none !important;
                                box-shadow: none !important;">
                                <td style="width: 55%; border:none !important; border-collapse:collapse;">
                                    <strong>Bill To:</strong>
                                    <br/>
                                    <span t-field="doc.partner_id.name"/>
                                    <br/>
                                    <span t-field="doc.partner_id.street"/>
                                    <br/>
                                    <span t-field="doc.partner_id.city"/>
                                    <br/>
                                    <span t-field="doc.partner_id.country_id.name"/>
                                </td>
                                <td style="width: 45%;">
                                    <table class="jea-info-table">
                                        <tr>
                                            <td class="jea-label">INV #</td>
                                            <td>
                                                <span t-field="doc.name"/>

                                            </td>
                                        </tr>
                                        <tr>
                                            <td class="jea-label">DATE</td>
                                            <td>
                                                <span t-field="doc.invoice_date"
                                                      t-options='{"widget": "date", "format": "dd-MMM-yyyy"}'/>
                                            </td>
                                        </tr>
                                        <tr>
                                            <td class="jea-label">JOB#</td>
                                            <td>
                                                <span t-field="doc.jea_job_number"/>
                                            </td>
                                        </tr>
                                        <tr>
                                            <td class="jea-label">TRN</td>
                                            <td>
                                                <span t-field="doc.jea_trn_display"/>
                                            </td>
                                        </tr>
                                    </table>
                                </td>
                            </tr>
                        </table>

                        <hr class="jea-divider"/>

                        <!-- ============ Order Ref / Payment / Project ============ -->
                        <table class="jea-refs-table" style="margin-bottom: 16px;">
                            <thead>
                                <tr>
                                    <th style="width: 25%;">ORDER REF:</th>
                                    <th style="width: 40%;">PAYMENT</th>
                                    <th style="width: 35%;">PROJECT</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td class="center">
                                        <span t-field="doc.jea_order_ref"/>
                                        <t t-if="doc.jea_order_ref_date">
                                            <br/>dt
                                            <span t-field="doc.jea_order_ref_date"
                                                  t-options='{"widget": "date", "format": "dd.MM.yyyy"}'/>
                                        </t>
                                    </td>
                                    <td class="center">
                                        <span style="white-space: pre-line;" t-field="doc.jea_payment_schedule"/>
                                    </td>
                                    <td class="center">
                                        <span t-field="doc.jea_project_reference"/>
                                    </td>
                                </tr>
                            </tbody>
                        </table>

                        <!-- ============ Invoice lines ============ -->
                        <table class="jea-lines-table">
                            <thead>
                                <tr>
                                    <th rowspan="2">SI#</th>
                                    <th rowspan="2">DESCRIPTION</th>
                                    <th rowspan="2">CLAIM</th>
                                    <th rowspan="2">QTY</th>
                                    <th rowspan="2">RATE</th>
                                    <th rowspan="2">VALUE</th>
                                    <th colspan="2">VAT</th>
                                    <th rowspan="2">TOTAL<br/>VALUE
                                    </th>
                                </tr>
                                <tr>
                                    <th>RATE</th>
                                    <th>AMT (<span t-esc="doc.currency_id.name"/>)
                                    </th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="doc.invoice_line_ids" t-as="line">
                                    <tr>
                                        <td class="center">
                                            <span t-esc="line_index + 1"/>
                                        </td>

                                        <td>
                                            <span t-field="line.name"/>
                                        </td>

                                        <td class="center">
                                            <t t-if="line.jea_claim_percentage">
                                                <span t-esc="'%.0f' % line.jea_claim_percentage"/>%
                                            </t>
                                        </td>

                                        <td class="center">
                                            <span t-field="line.quantity"/>
                                        </td>

                                        <td class="num">
                                            <span t-field="line.price_unit"/>
                                        </td>

                                        <td class="num">
                                            <span t-field="line.price_subtotal"/>
                                        </td>

                                        <td class="center">
                                            <t t-if="line.tax_ids">
                                                <span t-esc="', '.join([('%.0f' % t.amount) + '%' for t in line.tax_ids])"/>
                                            </t>
                                        </td>

                                        <td class="num">
                                            <span t-esc="line.price_total - line.price_subtotal"/>
                                        </td>

                                        <td class="num">
                                            <span t-field="line.price_total"/>
                                        </td>
                                    </tr>


                                </t>
                            </tbody>
                        </table>

                        <!-- ============ Grand total ============ -->
                        <table class="jea-grand-total">
                            <tr>
                                <td style="width: 70%; text-align: right;">
                                    Grand Total (<span t-esc="doc.currency_id.name"/>)
                                </td>
                                <td style="width: 15%; text-align: right;">
                                    <span t-field="doc.amount_untaxed"/>
                                </td>
                                <td style="width: 15%; text-align: right;">
                                    <span t-field="doc.amount_total"/>
                                </td>
                            </tr>
                        </table>

                        <!-- ============ Amount in words ============ -->
                        <div class="jea-amount-words">
                            <span t-esc="doc.currency_id.amount_to_text(doc.amount_total)"/>
                            Only.
                        </div>

                        <!-- ============ Signature / stamp / company name ============ -->
                        <table class="no-border" style="border: none !important;
                                border-style: hidden !important;
                                outline: none !important;
                                box-shadow: none !important;">
                            <tr style=" border: none;">
                                <td style="width: 60%;  border: none !important;"/>
                                <td class="jea-signature-block" style="width: 40%;  border: none !important;">
                                    <div class="jea-stamp-placeholder"/>
                                    <br/>
                                    <strong t-field="doc.company_id.name"/>
                                </td>
                            </tr>
                        </table>

                        <!--                         ============ Payment information footer ============ -->
                        <t t-set="bank" t-value="doc.company_id.bank_ids[:1]"/>
                        <t t-if="bank">
                            <div class="jea-payment-info">
                                <strong>Payment Information</strong>
                                <br/>

                                All cheques and Drafts to be made payable to
                                "<span t-field="doc.company_id.name"/>",

                                OR Wire Transfer to Bank Name:
                                <span t-field="bank.bank_id.name"/>
                                <br/>

                                A/c No.:
                                <span t-field="bank.acc_number"/>
                                <br/>

                                IBAN:
                                <span t-field="bank.acc_number"/>
                                <br/>

                                Swift Code:
                                <span t-field="bank.bank_id.bic"/>
                            </div>
                        </t>


                    </div>
                </t>
            </t>
        </t>
    </template>
    <template id="jea_external_layout_standard_address" inherit_id="web.external_layout_standard">
        <!-- Remove the default company address -->
        <xpath expr="//div[@name='company_address']" position="replace">
            <div class="col text-end" name="jea_company_address_right">
                <span t-field="company.street"/>
                <br/>
                <span t-field="company.city"/>
                <br/>
                <span t-field="company.country_id.name"/>
            </div>
        </xpath>
    </template>
</odoo>